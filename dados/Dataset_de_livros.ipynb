      "source": [
        "import re\n",
        "\n",
        "ILLEGAL_CHARS = re.compile(r'[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]')\n",
        "\n",
        "def limpar(valor):\n",
        "    if isinstance(valor, str):\n",
        "        return ILLEGAL_CHARS.sub('', valor)\n",
        "    return valor\n",
        "\n",
        "df = df.map(limpar)\n",
        "\n",
        "df.to_excel(\"livros_skoob.xlsx\", index=False, engine=\"openpyxl\")"
      ]
    }
  ]
}